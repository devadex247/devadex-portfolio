# Resend API Key (starts with re_...)
RESEND_API_KEY=your_resend_api_key_here

# The email address that will receive the messages (defaults to siteConfig.email if omitted)
CONTACT_RECEIVER_EMAIL=adextechhub@gmail.com

# Optional: Verified sender email in Resend (defaults to "Portfolio Contact <onboarding@resend.dev>")
# Once you verify your custom domain in Resend, you can change this to: "Adekunle AbdulMuheez <contact@yourdomain.com>"
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
